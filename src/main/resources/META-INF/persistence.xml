<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="http://xmlns.jcp.org/xml/ns/persistence" version="2.2">

    <persistence-unit name="gestion-reservations-pu"
                      transaction-type="RESOURCE_LOCAL">

        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!-- Entités du projet -->
        <class>com.example.model.Utilisateur</class>
        <class>com.example.model.Salle</class>
        <class>com.example.model.Reservation</class>
        <class>com.example.model.Equipement</class>

        <properties>
            <!-- Connexion à la base H2 -->
            <property name="javax.persistence.jdbc.driver"
                      value="org.h2.Driver"/>

            <property name="javax.persistence.jdbc.url"
                      value="jdbc:h2:mem:test;DB_CLOSE_DELAY=-1"/>

            <property name="javax.persistence.jdbc.user"
                      value="sa"/>

            <property name="javax.persistence.jdbc.password"
                      value=""/>

            <!-- Dialecte SQL -->
            <property name="hibernate.dialect"
                      value="org.hibernate.dialect.H2Dialect"/>

            <!-- Création automatique des tables -->
            <property name="hibernate.hbm2ddl.auto"
                      value="update"/>

            <!-- Affichage SQL -->
            <property name="hibernate.show_sql"
                      value="true"/>

            <property name="hibernate.format_sql"
                      value="true"/>

            <!-- Cache de second niveau -->
            <property name="hibernate.cache.use_second_level_cache"
                      value="true"/>

            <property name="hibernate.cache.region.factory_class"
                      value="org.hibernate.cache.jcache.JCacheRegionFactory"/>

            <property name="hibernate.javax.cache.provider"
                      value="org.ehcache.jsr107.EhcacheCachingProvider"/>

            <property name="hibernate.javax.cache.missing_cache_strategy"
                      value="create"/>

            <property name="hibernate.cache.use_query_cache"
                      value="true"/>

            <!-- Statistiques Hibernate -->
            <property name="hibernate.generate_statistics"
                      value="true"/>
        </properties>

    </persistence-unit>
</persistence>
